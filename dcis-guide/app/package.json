{
  "name": "dcis-guide-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:public && npm test && tsc && vite build && npm run check:bundle",
    "preview": "vite preview --host 0.0.0.0",
    "validate:image": "node scripts/validate-image.mjs",
    "export:public": "node scripts/export-public.mjs",
    "check:public": "node scripts/export-public.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check:bundle": "node scripts/check-public-bundle.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
